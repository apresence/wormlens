#!/usr/bin/env bash
set -uo pipefail

# ============================================================
# wormlens -- Infinite session continuity for Claude Code
#
# Replaces lossy compaction with lossless episodic memory.
# Monitors context usage, extracts on handoff, restarts
# with full recall. Zero context loss. 90% context free
# for real work after reload.
#
# Usage:
#   ./wormlens                          # interactive, default ctx limit
#   ./wormlens --ctx-limit 150000       # custom context limit
#   ./wormlens --prompt "build X"       # initial task prompt
#   ./wormlens --resume                 # resume from last extract
#   ./wormlens --dry-run                # show what would happen
# ============================================================

VERSION="0.1.0"
WORMLENS_DIR=".wormlens"
STATUS_FILE="$WORMLENS_DIR/status"
CTX_PCT_FILE="$WORMLENS_DIR/ctx_pct"
EXTRACT_DIR="$WORMLENS_DIR/extracts"
HANDOFF_MARKER="$WORMLENS_DIR/handoff_ready"
MONITOR_PID_FILE="$WORMLENS_DIR/monitor.pid"
SESSION_COUNT_FILE="$WORMLENS_DIR/session_count"
LOG_FILE="$WORMLENS_DIR/wormlens.log"

# Defaults
CTX_LIMIT=200000
INITIAL_PROMPT=""
RESUME=false
DRY_RUN=false
WL_CMD="python -m wormlens"
CLAUDE_CMD="claude"
POLL_INTERVAL=5

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

# -- Args --------------------------------------------------

while [[ $# -gt 0 ]]; do
    case $1 in
        --ctx-limit)     CTX_LIMIT="$2"; shift 2 ;;
        --prompt)        INITIAL_PROMPT="$2"; shift 2 ;;
        --resume)        RESUME=true; shift ;;
        --dry-run)       DRY_RUN=true; shift ;;
        --poll-interval) POLL_INTERVAL="$2"; shift 2 ;;
        --wl-cmd)   WL_CMD="$2"; shift 2 ;;
        --claude-cmd)    CLAUDE_CMD="$2"; shift 2 ;;
        -h|--help)
            echo "wormlens v$VERSION -- Infinite session continuity for Claude Code"
            echo ""
            echo "Usage: ./wormlens [options]"
            echo ""
            echo "Options:"
            echo "  --ctx-limit N       Context window size (default: 200000)"
            echo "  --prompt TEXT       Initial task prompt for first session"
            echo "  --resume            Resume from last wormlens extract"
            echo "  --dry-run           Show what would happen without running"
            echo "  --poll-interval N   Monitor poll interval in seconds (default: 5)"
            echo "  --wl-cmd CMD   wormlens command (default: python -m wormlens)"
            echo "  --claude-cmd CMD    Claude CLI command (default: claude)"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"; exit 1 ;;
    esac
done

# -- Helpers -----------------------------------------------

log() {
    local ts
    ts=$(date '+%H:%M:%S')
    echo -e "${DIM}[$ts]${NC} $1" | tee -a "$LOG_FILE"
}

wl_banner() {
    echo -e "${CYAN}"
    echo '  + ++=++=+++++  +=+++++=+'
    echo '  |||| |+++||||  |+ |||+=+'
    echo '  ++++=+++=+ ++=++=+++++=+'
    echo -e "${NC}${DIM}  v${VERSION} -- lossless session continuity${NC}"
    echo ""
}

get_session_count() {
    if [ -f "$SESSION_COUNT_FILE" ]; then
        cat "$SESSION_COUNT_FILE"
    else
        echo "0"
    fi
}

increment_session_count() {
    local count
    count=$(get_session_count)
    echo $((count + 1)) > "$SESSION_COUNT_FILE"
}

get_latest_extract() {
    if [ -d "$EXTRACT_DIR" ]; then
        ls -t "$EXTRACT_DIR"/*.md 2>/dev/null | head -1
    fi
}

# -- Monitor Management ------------------------------------

start_monitor() {
    log "Starting context monitor (limit: ${CTX_LIMIT} tokens, poll: ${POLL_INTERVAL}s)"
    python -m wormlens.harness.monitor \
        --ctx-limit "$CTX_LIMIT" \
        --status-dir "$WORMLENS_DIR" \
        --poll-interval "$POLL_INTERVAL" &
    local pid=$!
    echo "$pid" > "$MONITOR_PID_FILE"
    log "Monitor PID: $pid"
}

stop_monitor() {
    if [ -f "$MONITOR_PID_FILE" ]; then
        local pid
        pid=$(cat "$MONITOR_PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null || true
            log "Monitor stopped (PID $pid)"
        fi
        rm -f "$MONITOR_PID_FILE"
    fi
}

# -- Extract -----------------------------------------------

do_extract() {
    local session_num=$1
    local extract_file="$EXTRACT_DIR/session_${session_num}.md"

    log "Extracting session with wormlens..."
    mkdir -p "$EXTRACT_DIR"

    $WL_CMD --full --format chat -o "$extract_file" 2>/dev/null

    if [ -f "$extract_file" ] && [ -s "$extract_file" ]; then
        local size
        size=$(wc -c < "$extract_file" | tr -d ' ')
        local lines
        lines=$(wc -l < "$extract_file" | tr -d ' ')
        log "${GREEN}Extract saved: $extract_file ($size bytes, $lines lines)${NC}"
        echo "$extract_file"
    else
        log "${RED}Extract failed or empty${NC}"
        echo ""
    fi
}

# -- Boot Prompt Construction ------------------------------

build_boot_prompt() {
    local extract_file=$1
    local session_num=$2
    local prompt=""

    prompt+="You are resuming work via wormlens session continuity (session #${session_num}).

PREVIOUS SESSION MEMORY (lossless extract -- this is your complete episodic recall):

"

    if [ -f "$extract_file" ]; then
        prompt+="$(cat "$extract_file")"
    fi

    prompt+="

END OF PREVIOUS SESSION MEMORY.

IMPORTANT -- wormlens protocol:
1. You have full recall of the previous session above. Do NOT ask the user to repeat anything.
2. A context monitor is running. Check .wormlens/status periodically (read the file) to see your context fill %.
3. When context reaches ~85-90%, YOU decide when to initiate handoff:
   a. Reach a clean stopping point in your current task
   b. Run: $WL_CMD --full --format chat -o $EXTRACT_DIR/session_$((session_num + 1)).md
   c. Create the file .wormlens/handoff_ready
   d. Tell the user you're handing off, summarize what's pending
   e. The outer loop will restart you with full memory
4. Do NOT wait until context is critically full. Initiate handoff proactively at 85-90%.
5. You have ~90% of your context window free for real work. Use it.

Resume from where the previous session left off. Check what was in progress and continue."

    echo "$prompt"
}

build_initial_prompt() {
    local session_num=$1
    local prompt=""

    prompt+="wormlens session continuity is active (session #${session_num}).

WORMLENS PROTOCOL:
1. A context monitor is running. Check .wormlens/status periodically to see your context fill %.
2. When context reaches ~85-90%, YOU decide when to initiate handoff:
   a. Reach a clean stopping point
   b. Run: $WL_CMD --full --format chat -o $EXTRACT_DIR/session_$((session_num + 1)).md
   c. Create the file .wormlens/handoff_ready
   d. Tell the user you're handing off
3. The outer loop will restart you with full episodic memory from this session.

"

    if [ -n "$INITIAL_PROMPT" ]; then
        prompt+="TASK: $INITIAL_PROMPT"
    fi

    echo "$prompt"
}

# -- Cleanup -----------------------------------------------

cleanup() {
    log "Shutting down wormlens..."
    stop_monitor
    rm -f "$HANDOFF_MARKER"
    rm -f "$CTX_PCT_FILE"
    log "Clean exit."
    exit 0
}

trap cleanup SIGINT SIGTERM

# -- Main Loop ---------------------------------------------

main() {
    wl_banner
    mkdir -p "$WORMLENS_DIR" "$EXTRACT_DIR"
    touch "$LOG_FILE"

    log "Context limit: ${CTX_LIMIT} tokens"

    # Handle resume
    local session_num
    session_num=$(get_session_count)

    if [ "$RESUME" = true ]; then
        local last_extract
        last_extract=$(get_latest_extract)
        if [ -z "$last_extract" ]; then
            log "${RED}No previous extract found to resume from${NC}"
            exit 1
        fi
        log "Resuming from: $last_extract"
    fi

    if [ "$DRY_RUN" = true ]; then
        log "DRY RUN -- would start session #$((session_num + 1))"
        if [ "$RESUME" = true ]; then
            local le
            le=$(get_latest_extract)
            log "Would boot with extract: $le"
            log "Extract size: $(wc -c < "$le" | tr -d ' ') bytes"
        fi
        exit 0
    fi

    # -- The loop ------------------------------------------

    while true; do
        session_num=$(($(get_session_count) + 1))
        increment_session_count
        rm -f "$HANDOFF_MARKER"

        log "==========================================="
        log "${GREEN}SESSION #${session_num}${NC}"
        log "==========================================="

        # Start context monitor
        start_monitor

        # Build the prompt
        local boot_prompt
        local last_extract
        last_extract=$(get_latest_extract)

        if [ -n "$last_extract" ] && [ -f "$last_extract" ]; then
            log "Booting with extract: $(basename "$last_extract")"
            local extract_size
            extract_size=$(wc -c < "$last_extract" | tr -d ' ')
            log "Extract size: ${extract_size} bytes"
            boot_prompt=$(build_boot_prompt "$last_extract" "$session_num")
        else
            log "First session -- no prior memory"
            boot_prompt=$(build_initial_prompt "$session_num")
        fi

        # Launch Claude Code
        log "Launching Claude Code..."
        local claude_pid

        # Write boot prompt to temp file to avoid arg length limits
        local boot_file="$WORMLENS_DIR/boot_prompt.md"
        echo "$boot_prompt" > "$boot_file"

        # Launch CC with the prompt piped in
        # CC reads the prompt from the argument
        $CLAUDE_CMD --print "$(cat "$boot_file")" &
        claude_pid=$!

        log "Claude PID: $claude_pid"

        # -- Wait for handoff or exit ------------------

        while true; do
            # Check if Claude exited on its own (user quit, crash, etc)
            if ! kill -0 "$claude_pid" 2>/dev/null; then
                log "Claude exited (PID $claude_pid)"
                break
            fi

            # Check for handoff marker (agent initiated)
            if [ -f "$HANDOFF_MARKER" ]; then
                log "${YELLOW}Handoff signal received from agent${NC}"

                # Give agent a moment to finish writing
                sleep 2

                # Kill Claude
                kill "$claude_pid" 2>/dev/null
                wait "$claude_pid" 2>/dev/null || true
                log "Claude terminated for handoff"
                break
            fi

            # Check context level for forced handoff
            if [ -f "$CTX_PCT_FILE" ]; then
                local pct
                pct=$(cat "$CTX_PCT_FILE" 2>/dev/null || echo "0")
                # Force handoff at 95% if agent hasn't done it
                if (( $(echo "$pct > 95" | bc -l 2>/dev/null || echo 0) )); then
                    log "${RED}CRITICAL: Context at ${pct}% -- forcing handoff${NC}"
                    do_extract "$session_num"
                    kill "$claude_pid" 2>/dev/null
                    wait "$claude_pid" 2>/dev/null || true
                    break
                fi
            fi

            sleep 2
        done

        # Stop monitor
        stop_monitor

        # If no extract was created by the agent, create one now
        local expected_extract="$EXTRACT_DIR/session_${session_num}.md"
        if [ ! -f "$expected_extract" ] || [ ! -s "$expected_extract" ]; then
            log "Agent didn't create extract -- creating post-mortem extract"
            do_extract "$session_num"
        fi

        # Check if we have an extract to continue from
        local next_extract
        next_extract=$(get_latest_extract)
        if [ -z "$next_extract" ]; then
            log "${RED}No extract available. Cannot continue. Exiting.${NC}"
            break
        fi

        log ""
        log "${CYAN}Session #${session_num} complete. Restarting in 3s...${NC}"
        log "Extract: $(basename "$next_extract")"
        sleep 3
    done
}

main
